# Copy this file to .env before running anything: `cp .env.example .env`
#
# .env is gitignored; .env.example is not. Never place a real AWS credential
# in either file — this repository is public.

# Single naming source (D-16). Every resource name derives from this one
# variable; there are no per-resource overrides.
#   raw bucket      = ${PROJECT_NAME}-raw
#   curated bucket   = ${PROJECT_NAME}-curated
#   Glue database    = ${PROJECT_NAME with hyphens replaced by underscores}_db
# S3 bucket names forbid underscores, so the bucket names keep the hyphen.
# A Glue database name containing a hyphen must be quoted in every Athena
# query, so the database name replaces hyphens with underscores instead.
PROJECT_NAME=template-etl

# The emulator endpoint on the Compose network. run.sh refuses to run when
# this is empty, so a local command can never accidentally reach a real AWS
# account.
AWS_ENDPOINT_URL=http://floci:4566

# The region variable botocore actually honours.
AWS_DEFAULT_REGION=us-east-1

# Dummy credentials — Floci accepts any non-empty credential. A real AWS
# credential must never be placed here.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# The host port the emulator API is published on.
FLOCI_HOST_PORT=4566
